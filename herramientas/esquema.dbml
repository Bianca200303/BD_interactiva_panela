  disposicion_otro "text"
  observacion "text"
  created_by "uuid" [not null]
  created_at "timestamptz" [not null]
}
Table plant_packaging_seal_control_caes {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  control_date "date" [not null]
  control_time "time"
  presentacion "text"
  lote_code "text"
  destino "text"
