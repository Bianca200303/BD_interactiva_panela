Table plant_balance_calibration_caes {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  control_date "date" [not null]
  balance_code "text"
  area "text"
  equipment_name "text"
  error_maximo_permitido "text"
  peso_patron "text"
  p1_peso "numeric"
  p1_error "numeric"
  p2_peso "numeric"
  p2_error "numeric"
  p3_peso "numeric"
  p3_error "numeric"
  p4_peso "numeric"
  p4_error "numeric"
  p5_peso "numeric"
  p5_error "numeric"
  error_promedio "numeric"
  estado "text"
  acciones_correctivas "text"
  created_by "uuid" [not null]
  created_at "timestamptz" [not null]
}
Table plant_sieve_monitoring_caes {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  monitoring_date "date" [not null]
  lote_code "text"
