  symptoms_description "text" [not null]
  action_rest "boolean" [not null]
  action_medical_attention "boolean" [not null]
  action_relocation "boolean" [not null]
  action_medication "boolean" [not null]
  action_other "boolean" [not null]
  other_action_detail "text"
  return_date "date"
  certificate_presented "boolean" [not null]
  cooperative_id "uuid" [not null]
  created_by "varchar(8)" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table stowage_transport_inspections {
  id "uuid" [pk]
  exit_registration_id "uuid" [not null]
  inspection_date "date" [not null]
  cooperative_id "uuid" [not null]
  carrier_name "text" [not null]
  carrier_ruc "varchar(11)"
  carrier_license "varchar(20)"
  vehicle_brand "text" [not null]
  vehicle_plate "varchar(10)" [not null]
  vehicle_condition "vehicle_condition_enum" [not null]
  has_spare_tire "boolean" [not null]
  has_valid_soat "boolean" [not null]
  has_technical_review "boolean" [not null]
  has_first_aid_kit "boolean" [not null]
  has_fire_extinguisher "boolean" [not null]
  has_gps "boolean" [not null]
  has_cleaning_supplies "boolean" [not null]
  floors_clean "boolean" [not null]
  walls_clean "boolean" [not null]
  ceilings_clean "boolean" [not null]
  no_strange_odors "boolean" [not null]
  tarp_clean "boolean" [not null]
  pallets_clean "boolean" [not null]
  sack_clean_condition "sack_condition_enum" [not null]
  sack_tied_condition "sack_condition_enum" [not null]
  observations "text"
  created_by "varchar(8)" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
  registered_by_user_id "varchar(8)"
  formato_codigo "varchar(30)"
  emitted_by "uuid"
  emitted_by_name "text"
  emitted_at "timestamptz"
  firmantes "jsonb" [not null]
  status "varchar(20)" [not null]
}
TableGroup ccampo [color: #52b788, note: 'Controles de campo (BPM/HYS en módulo)'] {
worker_controls
worker_control_items
chlorine_residual_controls
cleaning_disinfections
cleaning_disinfection_items
pest_controls
