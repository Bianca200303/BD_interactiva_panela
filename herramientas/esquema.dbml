Project trazabilidad_panela {
  database_type: 'PostgreSQL'
  Note: 'Sistema de trazabilidad de panela: campo, lotes, planta y despacho. Esquema al 2026-10-21. Cada módulo es un grupo de color.'
}

// Sistema de trazabilidad de panela — esquema al 2026-10-21
Table cooperatives {
  id "uuid" [pk]
  name "varchar(255)" [not null]
  code "varchar(50)" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
  is_active "boolean"
  cane_density "numeric(5,4)"
  access_code "text"
}
Table coop_modules {
  id "uuid" [pk]
  name "varchar(255)" [not null]
  cooperative_id "uuid" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
  is_active "boolean"
  default_density "float8"
}
Table users {
  user_id "varchar(8)" [not null]
  first_name "varchar(100)" [not null]
  last_name "varchar(100)" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
  email "varchar(255)"
  auth_user_id "uuid"
  cooperative_id "uuid" [not null]
  role "text" [not null]
  coop_module_id "uuid"
  is_support "boolean"
}
Table web_users {
  id "uuid" [pk]
  auth_user_id "uuid" [not null]
  cooperative_id "uuid" [not null]
  first_name "varchar(100)" [not null]
  last_name "varchar(100)" [not null]
  role "varchar(50)" [not null]
  is_active "boolean" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
  username "varchar(50)" [not null]
}
Table user_module_assignments {
  user_id "varchar(8)" [not null]
  cooperative_id "uuid" [not null]
  coop_module_id "uuid" [not null]
  created_at "timestamptz"
}
Table campaigns {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  year "integer" [not null]
  start_date "date"
  end_date "date"
  is_active "boolean" [not null]
  created_at "timestamptz" [not null]
}
Table certified_workers {
  id "uuid" [pk]
  first_name "varchar(100)" [not null]
  last_name "varchar(100)" [not null]
  cooperative_id "uuid" [not null]
  coop_module_id "uuid" [not null]
  dni "varchar(8)"
  position "varchar(100)"
  certified_since "date"
  certified_until "date"
  is_active "boolean" [not null]
  notes "text"
  created_at "timestamptz" [not null]
  updated_at "timestamptz" [not null]
}
Table form_configurations {
  id "uuid" [pk]
  cooperative_id "uuid"
  step_key "text" [not null]
  fields "jsonb" [not null]
  is_active "boolean" [not null]
  version "integer" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
TableGroup org [color: #0f4c5c, note: 'Organización, usuarios y configuración'] {
cooperatives
coop_modules
users
web_users
user_module_assignments
campaigns
certified_workers
form_configurations
}
Table producers {
  id "uuid" [pk]
  first_name "varchar(255)" [not null]
  last_name "varchar(255)" [not null]
  dni "varchar(8)" [not null]
  cooperative_id "uuid" [not null]
  coop_module_id "uuid" [not null]
  is_member "boolean" [not null]
  is_active "boolean"
  created_at "timestamptz"
  updated_at "timestamptz"
  appagrop_code "varchar(50)"
  default_extraction_percentage "numeric(5,2)"
  default_cachaza_percentage "numeric(5,2)"
}
Table plots {
  id "uuid" [pk]
  code "varchar(100)"
  producer_id "uuid" [not null]
  is_active "boolean"
  created_at "timestamptz"
  updated_at "timestamptz"
  name "varchar(200)" [not null]
  default_extraction_percentage "numeric(5,2)"
  default_cachaza_percentage "numeric(5,2)"
}
Table producer_quotas {
  id "uuid" [pk]
  producer_id "uuid" [not null]
  batch_cert_id "uuid" [not null]
  cooperative_id "uuid" [not null]
  cupo_kg "numeric(10,2)" [not null]
  notes "text"
  created_by "varchar(8)"
  created_at "timestamptz" [not null]
  updated_at "timestamptz" [not null]
  coop_module_id "uuid" [not null]
  year "integer" [not null]
}
Table production_batches {
  id "uuid" [pk]
  batch_code "varchar(255)" [not null]
  harvest_date "date" [not null]
  process_date "date" [not null]
  cane_kg "numeric(10,2)" [not null]
  juice_liters "numeric(10,2)" [not null]
  efficiency_percentage "numeric(5,2)"
  producer_id "uuid" [not null]
  cooperative_id "uuid" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
  plot_id "uuid"
  panela_kg "numeric(10,2)"
  confitillo_kg "numeric(10,2)"
  porcentaje_extraccion "numeric(5,2)"
  cachaza_percentage "numeric(5,2)"
  cane_density "numeric(5,4)"
  latitude "float8"
  longitude "float8"
  location_text "text"
  observations "text"
  registered_by_user_id "varchar(8)"
}
Table production_batch_harvest_dates {
  id "uuid" [pk]
  production_batch_id "uuid" [not null]
  harvest_date "date" [not null]
  cooperative_id "uuid" [not null]
  created_at "timestamptz" [not null]
}
Table batch_temperatures {
  id "uuid" [pk]
  production_batch_id "uuid" [not null]
  temperature "numeric(6,2)" [not null]
  sequence_number "integer" [not null]
  cooperative_id "uuid" [not null]
  created_at "timestamptz"
  time_between_mieles_minutes "numeric(6,2)"
}
Table batch_ph_controls {
  id "uuid" [pk]
  production_batch_id "uuid" [not null]
  record_date "timestamptz"
  regulator_type "varchar(100)" [not null]
  ph_initial "numeric(4,2)" [not null]
  ph_final "numeric(4,2)" [not null]
  brix "numeric(5,2)"
  corrective_action "text"
  cooperative_id "uuid" [not null]
  created_at "timestamptz"
  regulator_quantity_kg "numeric(10,2)"
  regulator_quantity_value "numeric(10,2)"
  regulator_quantity_unit "varchar(10)"
}
Table batch_certs {
  id "uuid" [pk]
  name "varchar(100)" [not null]
  cooperative_id "uuid" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
  is_active "boolean"
  exclusion_group_id "uuid"
  is_default "boolean"
}
Table certificate_exclusion_groups {
  id "uuid" [pk]
  name "varchar(100)" [not null]
  display_name "varchar(100)" [not null]
  description "text"
  is_required "boolean"
  cooperative_id "uuid" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
  is_active "boolean"
}
Table production_batch_certs {
  id "uuid" [pk]
  production_batch_id "uuid" [not null]
  batch_cert_id "uuid" [not null]
  cooperative_id "uuid" [not null]
  created_at "timestamptz"
}
TableGroup campo [color: #2d6a4f, note: 'Productores y producción de campo'] {
producers
plots
producer_quotas
production_batches
production_batch_harvest_dates
batch_temperatures
batch_ph_controls
batch_certs
certificate_exclusion_groups
production_batch_certs
}
Table worker_controls {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  production_batch_id "uuid" [not null]
  worker_name "text" [not null]
  work_area "text" [not null]
  uniform_complete "boolean" [not null]
  no_makeup "boolean" [not null]
  nails_short_clean "boolean" [not null]
  nails_no_polish "boolean" [not null]
  hands_clean "boolean" [not null]
  no_jewelry "boolean" [not null]
  hair_covered "boolean" [not null]
  no_beard "boolean" [not null]
  no_wounds "boolean" [not null]
  observations "text"
  created_by "varchar(8)" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table worker_control_items {
  id "uuid" [pk]
  worker_control_id "uuid"
  worker_name "text" [not null]
  uniform_complete "boolean"
  no_makeup "boolean"
  nails_short_clean "boolean"
  nails_no_polish "boolean"
  hands_clean "boolean"
  no_jewelry "boolean"
  hair_covered "boolean"
  no_beard "boolean"
  no_wounds "boolean"
  created_at "timestamptz"
}
Table chlorine_residual_controls {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  coop_module_id "uuid" [not null]
  control_date "date" [not null]
  control_time "time" [not null]
  measurement_point_1 "numeric(4,2)" [not null]
  measurement_point_2 "numeric(4,2)" [not null]
  corrective_actions "text"
  observations "text"
  responsible_person "text" [not null]
  created_by "uuid" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table cleaning_disinfections {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  coop_module_id "uuid" [not null]
  cleaning_date "date" [not null]
  cleaning_types "text[]" [not null]
  general_observations "text"
  created_by "uuid" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table cleaning_disinfection_items {
  id "uuid" [pk]
  cleaning_disinfection_id "uuid" [not null]
  area_code "varchar(50)" [not null]
  point_code "varchar(50)" [not null]
  point_description "text" [not null]
  uses_chlorine "boolean" [not null]
  uses_detergent "boolean" [not null]
  uses_other_product "boolean" [not null]
  observations "text"
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table pest_controls {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  coop_module_id "uuid" [not null]
  control_date "date" [not null]
  created_by "uuid" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table pest_control_bait_records {
  id "uuid" [pk]
  pest_control_id "uuid" [not null]
  product_name "text" [not null]
  quantity "numeric(10,2)" [not null]
  unit "text" [not null]
  bait_stations "jsonb" [not null]
  bait_observations "text"
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table pest_control_insect_records {
  id "uuid" [pk]
  pest_control_id "uuid" [not null]
  product_name "text" [not null]
  quantity "numeric(10,2)" [not null]
  unit "text" [not null]
  insect_data "jsonb" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table environment_inspections {
  id "uuid" [pk]
  coop_module_id "uuid" [not null]
  inspection_date "date" [not null]
  cooperative_id "uuid" [not null]
  created_by "varchar(8)" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table environment_inspection_items {
  id "uuid" [pk]
  environment_inspection_id "uuid" [not null]
  area_code "varchar(50)" [not null]
  item_code "varchar(50)" [not null]
  item_description "text" [not null]
  condition "inspection_condition_enum" [not null]
  corrective_actions "text"
  observations "text"
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table equipment_maintenance_records {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  coop_module_id "uuid" [not null]
  maintenance_date "date" [not null]
  equipment_name "text" [not null]
  maintenance_type "text" [not null]
  maintenance_cause "text" [not null]
  materials_used "text"
  duration_hours "numeric(10,2)" [not null]
  responsible_person "text" [not null]
  created_by "varchar(8)" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table health_incidents {
  id "uuid" [pk]
  coop_module_id "uuid" [not null]
  employee_name "text" [not null]
  work_area "text" [not null]
