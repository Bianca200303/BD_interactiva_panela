Table exit_registrations {
  id "uuid" [pk]
  exit_code "varchar(50)" [not null]
  document_number "varchar(100)"
  exit_date "date" [not null]
  total_kg "numeric(10,2)" [not null]
  exit_type "varchar(50)" [not null]
  destination "varchar(100)"
  notes "text"
  cooperative_id "uuid" [not null]
  created_by "varchar(8)" [not null]
  created_at "timestamptz"
  updated_at "timestamptz"
}
Table exit_items {
  id "uuid" [pk]
  exit_registration_id "uuid" [not null]
  production_batch_id "uuid" [not null]
  quantity_kg "numeric(10,2)" [not null]
  is_autoconsumo "boolean" [not null]
  bags_count "numeric(10,2)"
  unit_price "numeric(10,2)"
  total_value "numeric(12,2)"
