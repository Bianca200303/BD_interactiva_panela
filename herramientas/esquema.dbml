  sin_fisuras "boolean" [not null]
  sin_desgaste "boolean" [not null]
  sin_deformaciones "boolean" [not null]
  sin_obstrucciones "boolean" [not null]
  hubo_desviacion "boolean" [not null]
  causa_raiz "text"
  acciones_correctivas "text"
  created_by "uuid" [not null]
  created_at "timestamptz" [not null]
  plant_batch_id "uuid" [not null]
}
Table plant_temp_humidity_control_caes {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  control_date "date" [not null]
  ubicacion "text" [not null]
  t1 "numeric"
  t2 "numeric"
  t3 "numeric"
  t_promedio "numeric"
  hr1 "numeric"
  hr2 "numeric"
  hr3 "numeric"
  hr_promedio "numeric"
  accion_correctiva "text"
  observaciones "text"
  created_by "uuid" [not null]
  created_at "timestamptz" [not null]
}
Table plant_waste_management_caes {
  id "uuid" [pk]
  cooperative_id "uuid" [not null]
  control_date "date" [not null]
  control_time "time"
  es_organico "boolean" [not null]
  es_aprovechable "boolean" [not null]
  es_no_aprovechable "boolean" [not null]
